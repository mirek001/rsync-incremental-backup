#!/bin/bash

# rsync-incremental-backup-local
# Fixed version addressing all identified issues

set -euo pipefail  # Exit on error, undefined variables, and pipe failures

# Configuration variables (change as you wish)
src="/path/to/source"
dst="/path/to/target"
backupDepth=7
timeout=1800
pathBak0="data"
rotationLockFileName=".rsync-rotation-lock"
pathBakN="backup"
nameBakN="backup"
exclusionFileName="exclude.txt"
ownFolderName=".rsync-incremental-backup"
logFolderName="log"

# Generate timestamp once
timestamp=$(date -Is)
datestamp=$(date -Id)
timestamp_short=$(date +%H-%M-%S)
logName="rsync-incremental-backup_${datestamp}_${timestamp_short}.log"

# Validate configuration
validate_config() {
    local errors=0
    
    if [[ -z "${src}" || -z "${dst}" ]]; then
        echo "Error: src and dst must be set" >&2
        errors=1
    fi
    
    if [[ ! -d "${src}" ]]; then
        echo "Error: Source directory '${src}' does not exist or is not accessible" >&2
        errors=1
    fi
    
    if [[ ! -d "$(dirname "${dst}")" ]]; then
        echo "Error: Parent directory of destination '${dst}' does not exist" >&2
        errors=1
    fi
    
    if [[ ! -w "$(dirname "${dst}")" ]]; then
        echo "Error: No write permission to destination parent directory" >&2
        errors=1
    fi
    
    if ! command -v rsync >/dev/null 2>&1; then
        echo "Error: rsync command not found" >&2
        errors=1
    fi
    
    if [[ ${backupDepth} -lt 1 ]]; then
        echo "Error: backupDepth must be at least 1" >&2
        errors=1
    fi
    
    return ${errors}
}

# Validate configuration before proceeding
if ! validate_config; then
    exit 1
fi

# Combine previously defined variables for use (fixed path transformation)
ownFolderPath="${HOME}/${ownFolderName}"
tempLogPath="${ownFolderPath}/local_${dst//\//_}"
exclusionFilePath="${ownFolderPath}/${exclusionFileName}"
bak0="${dst}/${pathBak0}"
rotationLockFilePath="${dst}/${rotationLockFileName}"
logPath="${dst}/${pathBakN}/${logFolderName}"
logFile="${tempLogPath}/${logName}"

# Create a proper lock mechanism to prevent concurrent execution
lockFile="${ownFolderPath}/.script-lock"
cleanup() {
    rm -f "${lockFile}"
}
trap cleanup EXIT

if ! mkdir "${ownFolderPath}" 2>/dev/null; then
    if [[ -f "${lockFile}" ]]; then
        if kill -0 "$(cat "${lockFile}")" 2>/dev/null; then
            echo "Another instance of the script is already running (PID: $(cat "${lockFile}"))"
            exit 1
        else
            echo "Removing stale lock file"
            rm -f "${lockFile}"
        fi
    fi
fi

echo $$ > "${lockFile}"

# Prepare log file
if ! mkdir -p "${tempLogPath}"; then
    echo "Error: Cannot create log directory '${tempLogPath}'" >&2
    exit 1
fi

if ! touch "${logFile}"; then
    echo "Error: Cannot create log file '${logFile}'" >&2
    exit 1
fi

writeToLog() {
    echo -e "$1" | tee -a "${logFile}"
}

writeToLog "********************************"
writeToLog "*                              *"
writeToLog "*   rsync-incremental-backup   *"
writeToLog "*                              *"
writeToLog "********************************"

# Prepare backup paths (fixed export/true usage)
i=1
while [[ ${i} -le ${backupDepth} ]]; do
    declare "bak${i}=${dst}/${pathBakN}/${nameBakN}.${i}"
    ((i = i + 1))
done

# Check if exclusion file exists, create empty one if not
if [[ ! -f "${exclusionFilePath}" ]]; then
    writeToLog "Creating empty exclusion file: ${exclusionFilePath}"
    touch "${exclusionFilePath}"
fi

# Prepare main rsync configuration (fixed quotation)
rsyncFlags="-achv --info=progress2 --timeout=${timeout} --delete -W"
rsyncFlags+=" --link-dest=${bak1}/ --log-file=${logFile} --exclude=${ownFolderPath} --chmod=+r"
rsyncFlags+=" --exclude-from=${exclusionFilePath}"

# Prepare log rsync configuration
logRsyncFlags="-rhv --remove-source-files --exclude=${logName} --log-file=${logFile}"

writeToLog "\\n[${timestamp}] You are going to backup"
writeToLog "\\tfrom:  ${src}"
writeToLog "\\tto:    ${bak0}"
writeToLog "\\tflags: ${rsyncFlags}"

# Prepare paths at destination
if ! mkdir -p "${dst}" "${logPath}"; then
    writeToLog "\\n[${timestamp}] Error: Cannot create destination directories"
    exit 1
fi

writeToLog "\\n[${timestamp}] Old logs sending begins\\n"

# Send old pending logs to destination
if ! rsync ${logRsyncFlags} "${tempLogPath}/" "${logPath}/"; then
    writeToLog "Warning: Could not send old logs to destination"
fi

writeToLog "\\n[${timestamp}] Old logs sending finished"

# Rotate backups if last rsync succeeded (fixed parentheses usage)
if [[ ! -e "${rotationLockFilePath}" ]]; then
    # .. and there is previous data
    if [[ -d "${bak0}" ]]; then
        writeToLog "\\n[${timestamp}] Backups rotation begins"

        ((i = i - 1))

        # Remove the oldest backup if exists
        local bakVar="bak${i}"
        local bakPath="${!bakVar}"
        if [[ -d "${bakPath}" ]]; then
            rm -rf "${bakPath}"
        fi

        # Rotate the previous backups
        while [[ ${i} -gt 0 ]]; do
            local bakNewVar="bak${i}"
            local bakNewPath="${!bakNewVar}"
            ((i = i - 1))
            local bakOldVar="bak${i}"
            local bakOldPath="${!bakOldVar}"
            if [[ -d "${bakOldPath}" ]]; then
                mv "${bakOldPath}" "${bakNewPath}"
            fi
        done

        writeToLog "[${timestamp}] Backups rotation finished\\n"
    else
        writeToLog "\\n[${timestamp}] No previous data found, there is no backups to be rotated\\n"
    fi
else
    writeToLog "\\n[${timestamp}] Last backup failed, backups will not be rotated\\n"
fi

# Set rotation lock file to detect in next run when backup fails
touch "${rotationLockFilePath}"

writeToLog "[${timestamp}] Backup begins\\n"

# Do the backup (fixed quotation)
if rsync ${rsyncFlags} "${src}/" "${bak0}/"; then
    writeToLog "\\n[${timestamp}] Backup completed successfully\\n"
    
    # Clear unneeded lock file
    rm -f "${rotationLockFilePath}"
    rsyncFail=0
else
    writeToLog "\\n[${timestamp}] Backup failed, try again later\\n"
    rsyncFail=1
fi

# Send the complete log file to destination
if ! mv "${logFile}" "${logPath}/"; then
    writeToLog "Warning: Could not move log file to destination"
    # Don't fail the script just because log couldn't be moved
fi

exit ${rsyncFail}
