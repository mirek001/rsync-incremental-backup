#!/bin/bash

# rsync-incremental-backup-remote
# Fixed version addressing all identified issues

set -euo pipefail  # Exit on error, undefined variables, and pipe failures

# Configuration variables (change as you wish)
src="/path/to/source"
dst="/path/to/target"
remote="ssh_remote"
backupDepth=7
timeout=1800
pathBak0="data"
partialFolderName=".rsync-partial"
rotationLockFileName=".rsync-rotation-lock"
pathBakN="backup"
nameBakN="backup"
exclusionFileName="exclude.txt"
ownFolderName=".rsync-incremental-backup"
logFolderName="log"

# Generate timestamp once
timestamp=$(date -Is)
datestamp=$(date -Id)
timestamp_short=$(date +%H-%M-%S)
logName="rsync-incremental-backup_${datestamp}_${timestamp_short}.log"

# Validate configuration
validate_config() {
    local errors=0
    
    if [[ -z "${src}" || -z "${dst}" || -z "${remote}" ]]; then
        echo "Error: src, dst, and remote must be set" >&2
        errors=1
    fi
    
    if [[ ! -d "${src}" ]]; then
        echo "Error: Source directory '${src}' does not exist or is not accessible" >&2
        errors=1
    fi
    
    if ! command -v rsync >/dev/null 2>&1; then
        echo "Error: rsync command not found" >&2
        errors=1
    fi
    
    if ! command -v ssh >/dev/null 2>&1; then
        echo "Error: ssh command not found" >&2
        errors=1
    fi
    
    if ! command -v scp >/dev/null 2>&1; then
        echo "Error: scp command not found" >&2
        errors=1
    fi
    
    if [[ ${backupDepth} -lt 1 ]]; then
        echo "Error: backupDepth must be at least 1" >&2
        errors=1
    fi
    
    return ${errors}
}

# SSH helper function with error checking
ssh_cmd() {
    local cmd="$1"
    local retries=3
    local count=0
    
    while [[ ${count} -lt ${retries} ]]; do
        if ssh -o BatchMode=yes -o ConnectTimeout=10 "${remote}" "${cmd}"; then
            return 0
        fi
        ((count++))
        if [[ ${count} -lt ${retries} ]]; then
            echo "SSH command failed, retrying in 5 seconds... (${count}/${retries})"
            sleep 5
        fi
    done
    
    echo "Error: SSH command failed after ${retries} attempts: ${cmd}" >&2
    return 1
}

# SSH test function
ssh_test() {
    local cmd="$1"
    ssh -q -o BatchMode=yes -o ConnectTimeout=10 "${remote}" "${cmd}"
}

# Validate configuration before proceeding
if ! validate_config; then
    exit 1
fi

# Combine previously defined variables for use (fixed path transformation)
ownFolderPath="${HOME}/${ownFolderName}"
tempLogPath="${ownFolderPath}/${remote}_${dst//\//_}"
exclusionFilePath="${ownFolderPath}/${exclusionFileName}"
remoteDst="${remote}:${dst}"
bak0="${dst}/${pathBak0}"
remoteBak0="${remoteDst}/${pathBak0}"
partialFolderPath="${dst}/${partialFolderName}"
rotationLockFilePath="${dst}/${rotationLockFileName}"
logPath="${dst}/${pathBakN}/${logFolderName}"
remoteLogPath="${remote}:${logPath}"
logFile="${tempLogPath}/${logName}"

# Create a proper lock mechanism to prevent concurrent execution
lockFile="${ownFolderPath}/.script-lock"
cleanup() {
    rm -f "${lockFile}"
}
trap cleanup EXIT

if ! mkdir "${ownFolderPath}" 2>/dev/null; then
    if [[ -f "${lockFile}" ]]; then
        if kill -0 "$(cat "${lockFile}")" 2>/dev/null; then
            echo "Another instance of the script is already running (PID: $(cat "${lockFile}"))"
            exit 1
        else
            echo "Removing stale lock file"
            rm -f "${lockFile}"
        fi
    fi
fi

echo $$ > "${lockFile}"

# Prepare log file
if ! mkdir -p "${tempLogPath}"; then
    echo "Error: Cannot create log directory '${tempLogPath}'" >&2
    exit 1
fi

if ! touch "${logFile}"; then
    echo "Error: Cannot create log file '${logFile}'" >&2
    exit 1
fi

writeToLog() {
    echo -e "$1" | tee -a "${logFile}"
}

writeToLog "********************************"
writeToLog "*                              *"
writeToLog "*   rsync-incremental-backup   *"
writeToLog "*                              *"
writeToLog "********************************"

# Prepare backup paths (fixed export/true usage)
i=1
while [[ ${i} -le ${backupDepth} ]]; do
    declare "bak${i}=${dst}/${pathBakN}/${nameBakN}.${i}"
    ((i = i + 1))
done

# Check if exclusion file exists, create empty one if not
if [[ ! -f "${exclusionFilePath}" ]]; then
    writeToLog "Creating empty exclusion file: ${exclusionFilePath}"
    touch "${exclusionFilePath}"
fi

# Prepare main rsync configuration (fixed quotation)
rsyncFlags="-achvz --info=progress2 --timeout=${timeout} --delete --no-W --partial-dir=${partialFolderName}"
rsyncFlags+=" --link-dest=${bak1}/ --log-file=${logFile} --exclude=${ownFolderPath} --chmod=+r"
rsyncFlags+=" --exclude-from=${exclusionFilePath}"

# Prepare log rsync configuration
logRsyncFlags="-rhvz --remove-source-files --exclude=${logName} --log-file=${logFile}"

writeToLog "\\n[${timestamp}] You are going to backup"
writeToLog "\\tfrom:  ${src}"
writeToLog "\\tto:    ${remoteBak0}"
writeToLog "\\tflags: ${rsyncFlags}"

# Check remote connection
writeToLog "\\n[${timestamp}] Testing remote connection..."
if ! ssh_test "exit"; then
    writeToLog "\\n[${timestamp}] Remote destination is not reachable"
    exit 1
fi
writeToLog "[${timestamp}] Remote connection successful"

# Prepare paths at destination
writeToLog "\\n[${timestamp}] Creating remote directories..."
if ! ssh_cmd "mkdir -p '${dst}' '${logPath}'"; then
    writeToLog "\\n[${timestamp}] Error: Cannot create destination directories on remote"
    exit 1
fi

writeToLog "\\n[${timestamp}] Old logs sending begins\\n"

# Send old pending logs to destination
if ! rsync ${logRsyncFlags} "${tempLogPath}/" "${remoteLogPath}/"; then
    writeToLog "Warning: Could not send old logs to destination"
fi

writeToLog "\\n[${timestamp}] Old logs sending finished"

# Rotate backups if last rsync succeeded (FIXED LOGIC)
# Check if partial folder doesn't exist AND rotation lock doesn't exist
if ssh_test "[ ! -d '${partialFolderPath}' ] && [ ! -e '${rotationLockFilePath}' ]"; then
    # .. and there is previous data
    if ssh_test "[ -d '${bak0}' ]"; then
        writeToLog "\\n[${timestamp}] Backups rotation begins"

        ((i = i - 1))

        # Remove the oldest backup if exists
        local bakVar="bak${i}"
        local bakPath="${!bakVar}"
        if ssh_test "[ -d '${bakPath}' ]"; then
            ssh_cmd "rm -rf '${bakPath}'"
        fi

        # Rotate the previous backups
        while [[ ${i} -gt 0 ]]; do
            local bakNewVar="bak${i}"
            local bakNewPath="${!bakNewVar}"
            ((i = i - 1))
            local bakOldVar="bak${i}"
            local bakOldPath="${!bakOldVar}"
            if ssh_test "[ -d '${bakOldPath}' ]"; then
                ssh_cmd "mv '${bakOldPath}' '${bakNewPath}'"
            fi
        done

        writeToLog "[${timestamp}] Backups rotation finished\\n"
    else
        writeToLog "\\n[${timestamp}] No previous data found, there is no backups to be rotated\\n"
    fi
else
    writeToLog "\\n[${timestamp}] Last backup failed, backups will not be rotated\\n"
fi

# Set rotation lock file to detect in next run when backup fails
ssh_cmd "touch '${rotationLockFilePath}'"

writeToLog "[${timestamp}] Backup begins\\n"

# Do the backup (fixed quotation)
if rsync ${rsyncFlags} "${src}/" "${remoteBak0}/"; then
    writeToLog "\\n[${timestamp}] Backup completed successfully\\n"
    
    # Clear unneeded partials and lock file
    ssh_cmd "rm -rf '${partialFolderPath}' '${rotationLockFilePath}'"
    rsyncFail=0
else
    writeToLog "\\n[${timestamp}] Backup failed, try again later\\n"
    rsyncFail=1
fi

# Send the complete log file to destination (improved error handling)
writeToLog "\\n[${timestamp}] Sending log file to destination..."
if scp "${logFile}" "${remoteLogPath}/"; then
    rm -f "${logFile}"
    writeToLog "[${timestamp}] Log file sent successfully"
else
    writeToLog "Warning: Could not send log file to destination"
    # Don't fail the script just because log couldn't be sent
fi

exit ${rsyncFail}
